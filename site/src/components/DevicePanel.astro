---
import type { Device } from '../data/content';

interface Props {
  devices: Device[];
}

const { devices } = Astro.props;
---

<div
  class="lg-glass"
  style="width: 100%; max-width: 420px; box-sizing: border-box; padding: 24px; display: flex; flex-direction: column; gap: 4px; background: var(--glass-3); border: 1px solid var(--glass-edge); border-radius: var(--radius-lg); box-shadow: var(--shadow-float);"
>
  <div style="display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 12px;">
    <span style="font-size: 17px; line-height: 24px; font-weight: 600;">Dispositivos</span>
    <span style="font-size: 14px; color: var(--ink-muted);">hace 20 s</span>
  </div>
  {
    devices.map((d) => (
      <div style="display: flex; align-items: center; gap: 16px; padding: 12px 0; border-top: 1px solid var(--glass-edge);">
        <svg width="60" height="60" viewBox="0 0 60 60" role="img" aria-label={d.aria} style="flex: none;">
          <circle
            cx="30"
            cy="30"
            r="26"
            fill="none"
            stroke={d.ring}
            stroke-width="5"
            stroke-linecap="round"
            stroke-dasharray={d.dash}
            transform="rotate(-90 30 30)"
          />
          <g transform="translate(18 18)" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d={d.icon} />
          </g>
        </svg>
        <div style="flex: 1; min-width: 0; display: flex; flex-direction: column;">
          <span style="font-weight: 600;">{d.name}</span>
          <span style="font-size: 14px; line-height: 20px; color: var(--ink-muted);">{d.kind}</span>
        </div>
        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 6px;">
          <span style="font-family: var(--font-mono); font-size: 20px; line-height: 24px; font-weight: 600;">{d.pct}%</span>
          {d.hasState && (
            <span
              style={`display: flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: var(--radius-pill); background: ${d.chipBg}; color: ${d.chipInk}; font-size: 14px; font-weight: 600; white-space: nowrap;`}
            >
              {d.low && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
                </svg>
              )}
              {d.charging && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M13 2 4 14h7l-1 8 9-12h-7z" />
                </svg>
              )}
              {d.state}
            </span>
          )}
        </div>
      </div>
    ))
  }
</div>
<div
  class="lg-glass"
  aria-label="Bandeja de Windows con un ícono por dispositivo"
  role="img"
  style="display: flex; align-items: center; gap: 14px; padding: 10px 16px; background: var(--glass-2); border: 1px solid var(--glass-edge); border-radius: var(--radius-sm); box-shadow: var(--shadow-glass);"
>
  {
    devices.map((d) => (
      <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
        <circle
          cx="13"
          cy="13"
          r="11"
          fill="none"
          stroke={d.ring}
          stroke-width="2.5"
          stroke-dasharray={d.dashSmall}
          transform="rotate(-90 13 13)"
        />
        <g transform="translate(7 7) scale(0.5)" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
          <path d={d.icon} />
        </g>
      </svg>
    ))
  }
  <span style="width: 1px; height: 20px; background: var(--glass-edge);"></span>
  <span data-tray-lang style="font-size: 13px; color: var(--ink-muted);">ESP</span>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--ink-muted);">
    <g data-tray-net="ethernet">
      <rect x="3" y="4" width="18" height="12" rx="1.5" />
      <path d="M12 16v4m-4 0h8" />
    </g>
    <g data-tray-net="wifi" style="display: none;">
      <path d="M2.5 9.5a14 14 0 0 1 19 0M5.5 13a9.5 9.5 0 0 1 13 0M8.5 16.5a5 5 0 0 1 7 0" />
      <circle cx="12" cy="20" r="0.8" fill="currentColor" />
    </g>
    <g data-tray-net="offline" style="display: none;">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9zM4 4l16 16" />
    </g>
  </svg>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--ink-muted);">
    <path d="M4 9h4l5-4v14l-5-4H4z" />
    <path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" />
  </svg>
  <span style="display: flex; flex-direction: column; align-items: flex-end; font-size: 12px; line-height: 16px; color: var(--ink-muted); font-variant-numeric: tabular-nums;">
    <span data-tray-time>21:47</span>
    <span data-tray-date>26/11/2026</span>
  </span>
</div>

<script>
  // The tray shows the visitor's own clock, keyboard language and connection, like the real one. Browsers expose
  // no system volume and, outside Chrome on Android, no connection type, so the speaker stays static and the network
  // icon shows wifi only when the browser says so.
  const LANG: Record<string, string> = {
    es: 'ESP', en: 'ENG', pt: 'POR', fr: 'FRA', de: 'DEU', it: 'ITA', nl: 'NLD', pl: 'POL',
    ru: 'RUS', tr: 'TRK', ja: 'JPN', ko: 'KOR', zh: 'CHS',
  };

  const lang = document.querySelector<HTMLElement>('[data-tray-lang]');
  const time = document.querySelector<HTMLElement>('[data-tray-time]');
  const date = document.querySelector<HTMLElement>('[data-tray-date]');
  const nets = document.querySelectorAll<SVGGElement>('[data-tray-net]');

  const code = (navigator.language || 'es').split('-')[0].toLowerCase();
  if (lang) lang.textContent = LANG[code] ?? code.toUpperCase();

  function tick() {
    const now = new Date();
    if (time) time.textContent = now.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
    if (date) date.textContent = now.toLocaleDateString(undefined, { day: '2-digit', month: '2-digit', year: 'numeric' });
    setTimeout(tick, 60_000 - (now.getSeconds() * 1000 + now.getMilliseconds()));
  }

  function showNetwork() {
    const type = (navigator as Navigator & { connection?: { type?: string } }).connection?.type;
    const active = !navigator.onLine ? 'offline' : type === 'wifi' ? 'wifi' : 'ethernet';
    nets.forEach((g) => (g.style.display = g.dataset.trayNet === active ? '' : 'none'));
  }

  tick();
  showNetwork();
  addEventListener('online', showNetwork);
  addEventListener('offline', showNetwork);
</script>
