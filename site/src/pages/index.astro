---
import BaseLayout from '../layouts/BaseLayout.astro';
import Aurora from '../components/Aurora.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Devices from '../components/Devices.astro';
import Notice from '../components/Notice.astro';
import Footer from '../components/Footer.astro';
import { devices, features, supported } from '../data/content';
---

<BaseLayout>
  <div
    style="position: relative; min-height: 100vh; overflow: hidden; background: var(--ground); color: var(--ink); font-family: var(--font-sans); font-size: 15px; line-height: 22px;"
  >
    <Aurora />
    <div class="lg-shell">
      <Header />
      <Hero devices={devices} />
      <Features features={features} />
      <Devices supported={supported} />
      <Notice />
      <Footer />
    </div>
  </div>
</BaseLayout>
