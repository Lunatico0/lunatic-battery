<!--
    Lunatic Glass for the dark app mode. Same Lunatic keys as Lunatic.Dark.xaml; AppTheme loads it instead of the
    Fluent pair when the user picks Lunatic Glass in Configuración (Lunatic.HighContrast.xaml still wins while Windows
    high contrast is on). Colors from the Lunatic Glass design: an aurora of teal, cyan and amber glows on #070C10,
    translucent panels and cards, pale text, a teal accent.
    WCAG, measured against the worst case (every glow at its peak under the panel or card): text 4.9:1 or more,
    ring tones 5.8:1 or more, the no-reading ring 3.5:1. The backdrop is drawn, not blurred: WPF has no public
    backdrop API, and the flyout is a layered window where the system backdrops do not apply.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ring segments, by LevelColor. -->
    <SolidColorBrush x:Key="Lunatic.Tone.High" Color="#4ADE80" />
    <SolidColorBrush x:Key="Lunatic.Tone.Medium" Color="#FBBF24" />
    <SolidColorBrush x:Key="Lunatic.Tone.Low" Color="#FB7185" />
    <SolidColorBrush x:Key="Lunatic.Tone.Charging" Color="#7DD3FC" />
    <!-- Ring tone when there is no reading. The depleted part of the ring is not drawn. -->
    <SolidColorBrush x:Key="Lunatic.Tone.Unlit" Color="#6B7C79" />

    <!-- Device silhouette inside the ring: known level, and no reading. -->
    <SolidColorBrush x:Key="Lunatic.Glyph" Color="#E8F1EF" />
    <SolidColorBrush x:Key="Lunatic.Glyph.Unknown" Color="#8A9B98" />

    <!-- State text under the value ("Batería baja", "Cargando"): the design's chip ink. -->
    <SolidColorBrush x:Key="Lunatic.State.Low" Color="#FECDD3" />
    <SolidColorBrush x:Key="Lunatic.State.Charging" Color="#BAE6FD" />

    <!-- Surfaces: the glow backdrop (opaque, it covers the Fluent window background), glass panels and cards. -->
    <DrawingBrush x:Key="Lunatic.Backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z" Brush="#070C10" />
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.15,0.85" GradientOrigin="0.15,0.85" RadiusX="0.6" RadiusY="0.6">
                            <GradientStop Offset="0" Color="#990E7490" />
                            <GradientStop Offset="1" Color="#000E7490" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.85,0.7" GradientOrigin="0.85,0.7" RadiusX="0.6" RadiusY="0.6">
                            <GradientStop Offset="0" Color="#8C14B8A6" />
                            <GradientStop Offset="1" Color="#0014B8A6" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.7,0.2" GradientOrigin="0.7,0.2" RadiusX="0.6" RadiusY="0.6">
                            <GradientStop Offset="0" Color="#47F59E0B" />
                            <GradientStop Offset="1" Color="#00F59E0B" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="Lunatic.Panel.Background" Color="#9E0A1216" />
    <SolidColorBrush x:Key="Lunatic.Panel.Stroke" Color="#1AFFFFFF" />
    <Thickness x:Key="Lunatic.Panel.StrokeThickness">1</Thickness>
    <CornerRadius x:Key="Lunatic.Panel.CornerRadius">16</CornerRadius>
    <Thickness x:Key="Lunatic.Panel.Margin">8</Thickness>
    <CornerRadius x:Key="Lunatic.Card.CornerRadius">12</CornerRadius>
    <CornerRadius x:Key="Lunatic.Flyout.CornerRadius">20</CornerRadius>
    <CornerRadius x:Key="Lunatic.Flyout.InnerCornerRadius">19</CornerRadius>
    <CornerRadius x:Key="Lunatic.Flyout.FooterCornerRadius">0,0,19,19</CornerRadius>
    <SolidColorBrush x:Key="Lunatic.Flyout.Footer" Color="Transparent" />
    <SolidColorBrush x:Key="Lunatic.Flyout.Row.Background" Color="#BD101C21" />
    <Thickness x:Key="Lunatic.Flyout.Row.Margin">12,3</Thickness>
    <Thickness x:Key="Lunatic.Flyout.Row.Padding">12,8</Thickness>

    <!--
        Fluent keys the Lunatic styles and the Fluent controls use. This dictionary is merged after the Fluent one, so
        these win only while Glass is chosen; high contrast never loads Glass.
    -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E8F1EF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9DB0AD" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#2DD4BF" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#14B8A6" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#03201C" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#BD101C21" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#1AFFFFFF" />
</ResourceDictionary>
