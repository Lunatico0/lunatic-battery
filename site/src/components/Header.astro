---
const iconHref = `${import.meta.env.BASE_URL}favicon.svg`;
---

<header
  class="lg-glass"
  style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 12px 12px 16px; background: var(--glass-1); border: 1px solid var(--glass-edge); border-radius: var(--radius-pill); box-shadow: var(--shadow-glass);"
>
  <a href="#top" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink);">
    <img src={iconHref} alt="" width="36" height="36" style="display: block; width: 36px; height: 36px;" />
    <span style="font-size: 17px; font-weight: 650; letter-spacing: -0.015em;">Lunatic Battery</span>
  </a>
  <nav aria-label="Principal" style="display: flex; flex-wrap: wrap; align-items: center; gap: 4px;">
    <a
      class="lg-btn lg-ghost"
      href="#funciones"
      style="padding: 10px 14px; border-radius: var(--radius-sm); color: var(--ink-muted); text-decoration: none; font-weight: 600;"
    >
      Funciones
    </a>
    <a
      class="lg-btn lg-ghost"
      href="#dispositivos"
      style="padding: 10px 14px; border-radius: var(--radius-sm); color: var(--ink-muted); text-decoration: none; font-weight: 600;"
    >
      Dispositivos
    </a>
    <a
      class="lg-btn lg-ghost"
      href="https://github.com/Lunatico0/lunatic-battery"
      style="display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: var(--radius-sm); color: var(--ink); text-decoration: none; font-weight: 600; border: 1px solid var(--glass-edge); background: var(--glass-2);"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"
        ></path>
      </svg>
      GitHub
    </a>
  </nav>
</header>
