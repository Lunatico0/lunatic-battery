<!--
    Lunatic tones for the light system theme. Same keys as Lunatic.Dark.xaml; AppTheme swaps one for the other.
    The ring tones are the tray icon's light taskbar ones (IconPalette.Light in Tray/IconPalette.cs): at least 4.3:1
    against #EEEEEE to #F3F3F3, so the ring clears 3:1 on every light Fluent surface. The state text keeps 4.5:1.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ring segments, by LevelColor. -->
    <SolidColorBrush x:Key="Lunatic.Tone.High" Color="#15803D" />
    <SolidColorBrush x:Key="Lunatic.Tone.Medium" Color="#B45309" />
    <SolidColorBrush x:Key="Lunatic.Tone.Low" Color="#B91C1C" />
    <SolidColorBrush x:Key="Lunatic.Tone.Charging" Color="#0E7490" />
    <!-- Segments past the level. -->
    <SolidColorBrush x:Key="Lunatic.Tone.Unlit" Color="#888888" />

    <!-- Device silhouette inside the ring: known level, and no reading. -->
    <SolidColorBrush x:Key="Lunatic.Glyph" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Lunatic.Glyph.Unknown" Color="#707070" />

    <!-- State text under the value ("Batería baja", "Cargando"); the other states use the secondary text color. -->
    <SolidColorBrush x:Key="Lunatic.State.Low" Color="#B91C1C" />
    <SolidColorBrush x:Key="Lunatic.State.Charging" Color="#0E7490" />
</ResourceDictionary>
