---
// Las tres manchas de luz del fondo. Una sola vez por página, detrás de todo el contenido.
// Siempre encendida: los tweaks del canvas de diseño no se portan como controles.
---

<div aria-hidden="true" style="position: absolute; inset: 0; pointer-events: none;">
  <div
    class="lg-blob"
    style="width: 62vw; height: 62vw; max-width: 900px; max-height: 900px; left: -12vw; top: -18vw; background: var(--aurora-1); opacity: 0.38;"
  >
  </div>
  <div
    class="lg-blob"
    style="width: 54vw; height: 54vw; max-width: 780px; max-height: 780px; right: -16vw; top: 6vw; background: var(--aurora-2); opacity: 0.42; animation-delay: -12s;"
  >
  </div>
  <div
    class="lg-blob"
    style="width: 30vw; height: 30vw; max-width: 440px; max-height: 440px; left: 30vw; top: 760px; background: var(--aurora-3); opacity: 0.16; animation-delay: -24s;"
  >
  </div>
</div>
