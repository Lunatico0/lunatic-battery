<!--
    Lunatic tones for a Windows high contrast theme. Same Lunatic keys as Lunatic.Dark.xaml; AppTheme loads it instead
    of the light or dark one while SystemParameters.HighContrast is on. Every color is a system color, read through
    DynamicResource so a switch between high contrast themes repaints live.
    The ring has no level colors here: the charge is drawn in the text color and the percentage beside it says the
    level. The depleted part is still not drawn.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ring segments: one tone for every level. -->
    <SolidColorBrush x:Key="Lunatic.Tone.High" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="Lunatic.Tone.Medium" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="Lunatic.Tone.Low" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="Lunatic.Tone.Charging" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <!-- Ring tone when there is no reading. -->
    <SolidColorBrush x:Key="Lunatic.Tone.Unlit" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />

    <!-- Device silhouette inside the ring: known level, and no reading. -->
    <SolidColorBrush x:Key="Lunatic.Glyph" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="Lunatic.Glyph.Unknown" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />

    <!-- State text under the value: the words carry the state, so it is plain text. -->
    <SolidColorBrush x:Key="Lunatic.State.Low" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="Lunatic.State.Charging" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />

    <!--
        Surfaces. The Fluent look keeps the windows as they were: no backdrop, no panels, the Fluent radii.
        Lunatic Glass (Lunatic.Glass.*.xaml) gives these keys its glow backdrop, translucent panels and larger radii.
    -->
    <SolidColorBrush x:Key="Lunatic.Backdrop" Color="Transparent" />
    <SolidColorBrush x:Key="Lunatic.Panel.Background" Color="Transparent" />
    <SolidColorBrush x:Key="Lunatic.Panel.Stroke" Color="Transparent" />
    <Thickness x:Key="Lunatic.Panel.StrokeThickness">0</Thickness>
    <CornerRadius x:Key="Lunatic.Panel.CornerRadius">0</CornerRadius>
    <Thickness x:Key="Lunatic.Panel.Margin">0</Thickness>
    <CornerRadius x:Key="Lunatic.Card.CornerRadius">6</CornerRadius>
    <CornerRadius x:Key="Lunatic.Flyout.CornerRadius">8</CornerRadius>
    <CornerRadius x:Key="Lunatic.Flyout.InnerCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="Lunatic.Flyout.FooterCornerRadius">0,0,7,7</CornerRadius>
    <SolidColorBrush x:Key="Lunatic.Flyout.Row.Background" Color="Transparent" />
    <Thickness x:Key="Lunatic.Flyout.Row.Margin">0</Thickness>
    <Thickness x:Key="Lunatic.Flyout.Row.Padding">16,6</Thickness>
    <!-- The flyout footer: the system window color. -->
    <SolidColorBrush x:Key="Lunatic.Flyout.Footer" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />

    <!--
        Fluent keys the Lunatic styles use, where the WPF high contrast dictionary (Fluent.HC.xaml) does not give a
        system pair: it maps the accent brushes to the accent color, which can sit near the background of a dark high
        contrast theme, and the switch knob to the same color as its track. This dictionary is merged after the Fluent
        one, so these win only while high contrast is on.
    -->
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}" />
</ResourceDictionary>
