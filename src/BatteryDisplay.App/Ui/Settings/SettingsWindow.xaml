<Window x:Class="BatteryDisplay.App.Ui.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BatteryDisplay.App.Ui.Controls"
        xmlns:flyout="clr-namespace:BatteryDisplay.App.Ui.Flyout"
        xmlns:settings="clr-namespace:BatteryDisplay.App.Ui.Settings"
        Title="Configuración de Lunatic Battery"
        Width="960"
        Height="640"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Shows a section's panel only while that section is selected in the navigation. -->
        <Style x:Key="SectionPanel" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Lunatic.PrimaryText}">
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardHint" TargetType="TextBlock" BasedOn="{StaticResource Lunatic.SecondaryText}">
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- A hidden device stays in the list, dimmed, so it can be shown again. -->
        <Style x:Key="HiddenDeviceDim" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Hidden}" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The device options while the device is hidden: still visible, but clearly off. -->
        <Style x:Key="DeviceOptions" TargetType="StackPanel">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Grid.Column="0" Margin="8,12,4,12">
            <TextBlock DockPanel.Dock="Top"
                       Margin="12,4,12,16"
                       Style="{StaticResource Lunatic.PrimaryText}"
                       FontWeight="SemiBold"
                       Text="{Binding AppTitle}" />
            <ListBox ItemsSource="{Binding Sections}"
                     SelectedValuePath="Section"
                     SelectedValue="{Binding SelectedSection}"
                     Background="Transparent"
                     BorderThickness="0"
                     AutomationProperties.Name="Secciones">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Width="28"
                                       FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding Glyph}" />
                            <TextBlock Style="{StaticResource Lunatic.PrimaryText}" VerticalAlignment="Center" Text="{Binding Title}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="24,16,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Margin="0,0,0,16"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{Binding SectionTitle}" />

            <!-- Dispositivos -->
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid" BasedOn="{StaticResource SectionPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static settings:SettingsSection.Devices}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.ColumnSpan="2"
                           Style="{StaticResource CardHint}"
                           FontSize="14"
                           Text="{x:Static flyout:FlyoutViewModel.EmptyText}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Lunatic.BoolToVisibility}}" />

                <ListBox Grid.Column="0"
                         Margin="0,0,0,16"
                         ItemsSource="{Binding Devices}"
                         SelectedItem="{Binding SelectedDevice}"
                         HorizontalContentAlignment="Stretch"
                         Background="Transparent"
                         BorderThickness="0"
                         AutomationProperties.Name="Dispositivos"
                         Visibility="{Binding HasSelection, Converter={StaticResource Lunatic.BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource HiddenDeviceDim}">
                                    <controls:BatteryRing Width="32" Height="32" Style="{StaticResource Lunatic.DeviceRing}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Style="{StaticResource HiddenDeviceDim}">
                                    <TextBlock Style="{StaticResource Lunatic.PrimaryText}" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource Lunatic.SecondaryText}" Text="{Binding Source}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Right"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Style="{StaticResource HiddenDeviceDim}"
                                               Text="{Binding ValueText}" />
                                    <TextBlock HorizontalAlignment="Right"
                                               Style="{StaticResource Lunatic.SecondaryText}"
                                               FontSize="12"
                                               Text="Oculto"
                                               Visibility="{Binding Hidden, Converter={StaticResource Lunatic.BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer Grid.Column="1"
                              Margin="16,0,0,0"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection, Converter={StaticResource Lunatic.BoolToVisibility}}">
                    <StackPanel Margin="0,0,0,24">
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:BatteryRing Width="56"
                                                  Height="56"
                                                  DataContext="{Binding SelectedDevice}"
                                                  Style="{StaticResource Lunatic.DeviceRing}" />
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="20"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="{Binding DetailTitle}" />
                                <TextBlock Style="{StaticResource Lunatic.SecondaryText}" FontSize="14" Text="{Binding DetailSubtitle}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Lunatic.Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Mostrar este dispositivo" />
                                    <TextBlock Style="{StaticResource CardHint}" Text="Si lo apagás, no aparece en la bandeja ni en el panel" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource Lunatic.ToggleSwitch}"
                                          IsChecked="{Binding ShowDevice}"
                                          AutomationProperties.Name="Mostrar este dispositivo" />
                            </Grid>
                        </Border>

                        <StackPanel IsEnabled="{Binding OptionsEnabled}" Style="{StaticResource DeviceOptions}">
                            <Border Style="{StaticResource Lunatic.Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Ícono propio en la bandeja" />
                                        <TextBlock Style="{StaticResource CardHint}" Text="{Binding PinnedHint}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource Lunatic.ToggleSwitch}"
                                              IsChecked="{Binding Pinned}"
                                              IsEnabled="{Binding CanPin}"
                                              AutomationProperties.Name="Ícono propio en la bandeja" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Lunatic.Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Avisar cuando baje de" />
                                        <TextBlock Style="{StaticResource CardHint}" Text="Una sola notificación por descarga" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              MinWidth="96"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding ThresholdOptions}"
                                              SelectedItem="{Binding LowBatteryThreshold}"
                                              ItemStringFormat="{}{0}%"
                                              AutomationProperties.Name="Avisar cuando baje de" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Lunatic.Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Avisar cuando termine de cargar" />
                                        <TextBlock Style="{StaticResource CardHint}" Text="Útil para desenchufarlo a tiempo" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource Lunatic.ToggleSwitch}"
                                              IsChecked="{Binding NotifyWhenCharged}"
                                              AutomationProperties.Name="Avisar cuando termine de cargar" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Lunatic.Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Nombre visible" />
                                        <TextBlock Style="{StaticResource CardHint}" Text="Cómo aparece en el tooltip y el panel" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1"
                                             Width="220"
                                             VerticalAlignment="Center"
                                             Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}"
                                             controls:TextBoxBehaviors.CommitOnEnter="True"
                                             AutomationProperties.Name="Nombre visible" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Bandeja y avisos -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource SectionPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static settings:SettingsSection.Tray}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl Margin="0,0,0,24" ItemsSource="{Binding TrayModes}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Lunatic.Card}">
                                <RadioButton GroupName="TrayIconMode"
                                             IsChecked="{Binding IsSelected}"
                                             AutomationProperties.Name="{Binding Title}">
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Style="{StaticResource CardTitle}" FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource CardHint}" Text="{Binding Description}" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- General -->
            <StackPanel Grid.Row="1">
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource SectionPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static settings:SettingsSection.General}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource Lunatic.Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CardTitle}" Text="Iniciar con Windows" />
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource Lunatic.ToggleSwitch}"
                                  IsChecked="{Binding StartWithWindows}"
                                  AutomationProperties.Name="Iniciar con Windows" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Acerca de -->
            <StackPanel Grid.Row="1">
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource SectionPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static settings:SettingsSection.About}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource Lunatic.Card}">
                    <StackPanel>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{x:Static settings:SettingsViewModel.AppName}" />
                        <TextBlock Style="{StaticResource CardHint}" FontSize="14" Text="{Binding VersionText}" />
                        <TextBlock Style="{StaticResource CardHint}" FontSize="14" Text="{x:Static settings:SettingsViewModel.LicenseText}" />
                        <Button Margin="-4,8,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource Lunatic.LinkButton}"
                                FontSize="14"
                                Content="{Binding RepositoryText}"
                                Command="{Binding OpenRepositoryCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
