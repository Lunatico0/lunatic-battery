<!--
    Lunatic Glass for the light app mode. Same Lunatic keys as Lunatic.Dark.xaml. The design draws Glass in dark
    only, so this one is derived from it: the same glows, fainter, on a pale base; white translucent panels and cards;
    dark text; the ring tones of Lunatic.Light.xaml (the tray icon's light taskbar ones).
    WCAG, measured against the worst case (every glow at its peak under the panel or card): text 6.0:1 or more,
    ring tones 4.7:1 or more, the no-reading ring 3.4:1.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ring segments, by LevelColor. -->
    <SolidColorBrush x:Key="Lunatic.Tone.High" Color="#15803D" />
    <SolidColorBrush x:Key="Lunatic.Tone.Medium" Color="#B45309" />
    <SolidColorBrush x:Key="Lunatic.Tone.Low" Color="#B91C1C" />
    <SolidColorBrush x:Key="Lunatic.Tone.Charging" Color="#0E7490" />
    <!-- Ring tone when there is no reading. The depleted part of the ring is not drawn. -->
    <SolidColorBrush x:Key="Lunatic.Tone.Unlit" Color="#7A8886" />

    <!-- Device silhouette inside the ring: known level, and no reading. -->
    <SolidColorBrush x:Key="Lunatic.Glyph" Color="#0B1F1C" />
    <SolidColorBrush x:Key="Lunatic.Glyph.Unknown" Color="#5F706D" />

    <!-- State text under the value ("Batería baja", "Cargando"); the other states use the secondary text color. -->
    <SolidColorBrush x:Key="Lunatic.State.Low" Color="#B91C1C" />
    <SolidColorBrush x:Key="Lunatic.State.Charging" Color="#0E7490" />

    <!-- Surfaces: the glow backdrop (opaque, it covers the Fluent window background), glass panels and cards. -->
    <DrawingBrush x:Key="Lunatic.Backdrop" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z" Brush="#EEF5F3" />
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.15,0.85" GradientOrigin="0.15,0.85" RadiusX="0.6" RadiusY="0.6">
                            <GradientStop Offset="0" Color="#380E7490" />
                            <GradientStop Offset="1" Color="#000E7490" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.85,0.7" GradientOrigin="0.85,0.7" RadiusX="0.6" RadiusY="0.6">
                            <GradientStop Offset="0" Color="#4D14B8A6" />
                            <GradientStop Offset="1" Color="#0014B8A6" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.7,0.2" GradientOrigin="0.7,0.2" RadiusX="0.6" RadiusY="0.6">
                            <GradientStop Offset="0" Color="#2EF59E0B" />
                            <GradientStop Offset="1" Color="#00F59E0B" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="Lunatic.Panel.Background" Color="#9EFFFFFF" />
    <SolidColorBrush x:Key="Lunatic.Panel.Stroke" Color="#1F0F2828" />
    <Thickness x:Key="Lunatic.Panel.StrokeThickness">1</Thickness>
    <CornerRadius x:Key="Lunatic.Panel.CornerRadius">16</CornerRadius>
    <Thickness x:Key="Lunatic.Panel.Margin">8</Thickness>
    <CornerRadius x:Key="Lunatic.Card.CornerRadius">12</CornerRadius>
    <CornerRadius x:Key="Lunatic.Flyout.CornerRadius">20</CornerRadius>
    <CornerRadius x:Key="Lunatic.Flyout.InnerCornerRadius">19</CornerRadius>
    <CornerRadius x:Key="Lunatic.Flyout.FooterCornerRadius">0,0,19,19</CornerRadius>
    <SolidColorBrush x:Key="Lunatic.Flyout.Footer" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="Lunatic.Flyout.Row.Background" Color="#BDFFFFFF" />
    <Thickness x:Key="Lunatic.Flyout.Row.Margin">12,3</Thickness>
    <Thickness x:Key="Lunatic.Flyout.Row.Padding">12,8</Thickness>

    <!--
        Fluent keys the Lunatic styles and the Fluent controls use. This dictionary is merged after the Fluent one, so
        these win only while Glass is chosen; high contrast never loads Glass.
    -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#0B1F1C" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#3D524F" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#115E59" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0F766E" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#BDFFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1A0F2828" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#1F0F2828" />
</ResourceDictionary>
